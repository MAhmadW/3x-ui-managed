# edge   = the platform terminates TLS and forwards plain HTTP to the container
# direct = this container owns 443 and gets its own certificate for $DOMAIN
PROXY_MODE=edge

# direct mode: public hostname pointing at this container
# DOMAIN=vpn.example.com

# Panel sub-path. Pick something unguessable.
PANEL_PATH=/change-me-panel/

# Prefix for VLESS routes: <prefix>/<port> -> inbound on 127.0.0.1:<port>
# (ports 10000-10999). Pick something unguessable, different from PANEL_PATH.
VPN_PATH_PREFIX=/change-me-vpn

# Required: the panel login. The container will not start without both.
# Applied on every start, so change them here, not in the panel.
PANEL_USERNAME=
PANEL_PASSWORD=

# Optional: use Postgres when the platform has no persistent disk.
# XUI_DB_TYPE=postgres
# XUI_DB_DSN=postgres://user:pass@host:5432/xui?sslmode=require
